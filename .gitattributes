# 统一换行，避免 Linux 构建时被 CRLF 破坏
* text=auto eol=lf

# Dockerfile 里有多行续行（HEALTHCHECK 的 `\`），必须是 LF，否则 \r 会混进命令
Dockerfile text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Windows 脚本反而必须是 CRLF，否则 cmd.exe / PowerShell 可能报错
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不参与换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
*.zip binary
*.vhdx binary
